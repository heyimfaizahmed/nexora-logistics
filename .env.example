# NEXORA TRADE & LOGISTICS — PRODUCTION ENVIRONMENT CONFIGURATION
# Duplicate this file to '.env' or '.env.production' and configure with verified enterprise endpoints.

# Public contact endpoints (displayed in Allocation Intake and Footer)
VITE_CONTACT_EMAIL=dispatch@nexora-trade.com
VITE_CONTACT_PHONE="+31 (0) 10 892 4100"
VITE_CONTACT_ADDRESS="Nexora Trade Tower, Level 42, Wilhelminakade 901, 3072 AP Rotterdam, Netherlands"

# Form submission webhook / API endpoint
# Leave blank to run in simulated/demo dispatch mode
VITE_FORM_ENDPOINT=

# Canonical Production URL (used for sitemap, canonical links, and OG cards)
VITE_SITE_URL=https://DOMAIN_PLACEHOLDER
